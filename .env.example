# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Solo en el servidor (webhooks y tareas internas). Nunca la expongas al navegador.
SUPABASE_SERVICE_ROLE_KEY=

# URL pública de la app (para enlaces en correos y WhatsApp)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Marca (nombre provisional)
NEXT_PUBLIC_BRAND_NAME=Mostrador
NEXT_PUBLIC_BRAND_DOMAIN=mostrador.cl
NEXT_PUBLIC_SUPPORT_WHATSAPP=
NEXT_PUBLIC_SUPPORT_EMAIL=hola@mostrador.cl

# Asistente de ayuda (solo servidor). Clave de console.anthropic.com → API Keys.
ANTHROPIC_API_KEY=
# Opcionales
ASSISTANT_MODEL=claude-opus-5-5
ASSISTANT_DAILY_LIMIT=60
